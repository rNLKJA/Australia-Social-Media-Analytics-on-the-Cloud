# Social Sense web app: environment variables
#
# Nothing here is required. The site is read-only: it ships a bundled SQLite
# file (data/analytics.db) and static assets, and holds no secrets.
#
# There is deliberately no AI API key here. The optional AI features use the
# visitor's own key, kept in their browser and sent only to their provider
# (see docs/decisions/DR-004-byok-text-to-sql.md). Never add one.

# Absolute origin used for Open Graph / Twitter card image URLs, e.g.
#   NEXT_PUBLIC_SITE_URL=https://comp90024-social-sense.vercel.app
# If unset, the build falls back to Vercel's VERCEL_PROJECT_PRODUCTION_URL,
# then VERCEL_URL (both set automatically on Vercel), then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

